        "device_id": {
          "name": "TV",
          "description": "The TV to control."
        },
        "uri": {
          "name": "URI",
          "description": "Full luna:// URI."
        },
        "params": {
          "name": "Parameters",
          "description": "Method parameters."
        }
      }
    },
