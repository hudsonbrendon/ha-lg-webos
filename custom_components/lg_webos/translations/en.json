{
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "ip_control": "LG IP Control"
        },
        "data_description": {
          "ip_control": "Turns on the TV's IP Control service (TCP 9761) with a key generated here. Adds remote lock, aspect ratio and the ip_control action."
        }
      }
    }
  },
  "config": {
    "flow_title": "{name} ({host})",
    "step": {
      "user": {
        "title": "LG webOS TV",
        "menu_options": {
          "import_native": "Import from the built-in LG webOS TV integration",
          "manual": "Enter the address"
        }
      },
      "import_native": {
        "title": "Import TVs",
        "description": "The pairing is reused, so nothing shows on the TV and it may be off. The built-in integration keeps working.",
        "data": {
          "entries": "TVs"
        }
      },
      "manual": {
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "IP address or hostname of the TV. It has to be on."
        }
      },
      "pairing": {
        "title": "Pair with {name}",
        "description": "Submit, then accept the request on the TV ({host})."
      },
      "reconfigure": {
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "New IP address or hostname of the TV."
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect. Is the TV on?",
      "pairing_refused": "The TV refused the pairing. Accept the request on screen."
    },
    "abort": {
      "already_configured": "This TV is already configured",
      "cannot_connect": "Could not connect to the TV",
      "wrong_device": "That address belongs to a different TV",
      "reconfigure_successful": "Address updated",
      "reauth_successful": "Paired again"
    }
