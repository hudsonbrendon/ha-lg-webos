  "services": {
    "button": {
      "name": "Press button",
      "description": "Presses a key of the remote.",
      "fields": {
        "device_id": {
          "name": "TV",
          "description": "The TV to control."
        },
        "button": {
          "name": "Button",
          "description": "Key name, e.g. HOME, BACK, ENTER, UP, MENU."
        }
      }
    },
    "command": {
      "name": "Send command",
      "description": "Sends an SSAP request and returns the answer.",
      "fields": {
        "device_id": {
          "name": "TV",
          "description": "The TV to control."
        },
        "command": {
          "name": "Command",
          "description": "SSAP URI without the ssap:// prefix."
        },
